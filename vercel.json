{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "functions": {
        "app/main.py": { "maxDuration": 300 }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build -- --mode vercel",
      "devCommand": "npm run dev -- --mode vercel --port $PORT",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    { "source": "/rooms", "destination": { "service": "app" } },
    { "source": "/rooms/(.*)", "destination": { "service": "app" } },
    { "source": "/ws/(.*)", "destination": { "service": "app" } },
    { "source": "/health", "destination": { "service": "app" } },
    { "source": "/static/index.html", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
